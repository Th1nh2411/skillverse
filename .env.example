# ---- Database (local: docker compose; demo: Neon) ----
# Neon: dùng chuỗi "pooled" cho DATABASE_URL và chuỗi direct cho DIRECT_URL (migration)
DATABASE_URL="postgresql://skillverse:skillverse@localhost:5433/skillverse"
DIRECT_URL="postgresql://skillverse:skillverse@localhost:5433/skillverse"
# Số kết nối tối đa mỗi instance serverless (Neon pooled)
DATABASE_POOL_MAX="5"

# ---- Auth.js ----
AUTH_SECRET="dev-only-change-me-32-bytes-minimum-xxxxxxxx"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Magic link email (SMTP). Để trống ở local: link in ra console server.
EMAIL_SERVER=""
EMAIL_FROM="SkillVerse <no-reply@example.com>"
# Chỉ local/e2e: cho phép đăng nhập nhanh bằng handle seed (KHÔNG bật trên production)
AUTH_DEV_LOGIN="true"
# Chỉ để thử đăng nhập dev trên bản build/preview (next start). Vercel production LUÔN tắt.
AUTH_DEV_LOGIN_ALLOW_PRODUCTION=""

# ---- Object storage (local: MinIO; demo: Cloudflare R2) ----
S3_ENDPOINT="http://localhost:9000"
# URL trình duyệt dùng để upload (R2: giống S3_ENDPOINT)
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_BUCKET="skillverse-proofs"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"

# ---- Cron (GitHub Actions gọi POST /api/cron mỗi 10 phút) ----
CRON_SECRET="dev-cron-secret"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
