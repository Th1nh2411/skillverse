{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV", "DATABASE_URL", "DIRECT_URL", "AUTH_SECRET", "AUTH_URL", "AUTH_GOOGLE_ID", "AUTH_GOOGLE_SECRET", "EMAIL_SERVER", "EMAIL_FROM", "S3_ENDPOINT", "S3_REGION", "S3_BUCKET", "S3_ACCESS_KEY_ID", "S3_SECRET_ACCESS_KEY", "S3_PUBLIC_ENDPOINT", "CRON_SECRET", "NEXT_PUBLIC_APP_URL", "AUTH_DEV_LOGIN"],
  "tasks": {
    "build": { "dependsOn": ["^build", "^generate"], "outputs": [".next/**", "!.next/cache/**", "dist/**"] },
    "generate": { "cache": false },
    "dev": { "dependsOn": ["^generate"], "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^generate"] },
    "typecheck": { "dependsOn": ["^generate"] },
    "test": { "dependsOn": ["^generate"], "outputs": ["coverage/**"] }
  }
}
